// 排行名次快照（进步榜 + 排行榜升降列数据源；2026-10-22 重构，替代 2008 版滚动 Rank_1..31 表 + Old_Rank）。
// 旧结构「每人每天一行」14 天已 9.8 万行（~255 万行/年），改为**每人一行**：
//   ranks    = JSON 对象 {"2026-10-21":123,…}，滚动保留 31 天的「总计时间榜名次」（3bvs 名次无消费方，已删）
//   delta    = 每日刷新时预计算：窗口内最早可得快照名次 − 今日名次（正=进步，沿用旧站 30 天口径）
//   baseDate = delta 所用基准日（30 天窗口内最早可得快照那天）
// 刷新由每日定时脚本（scripts/rank-snapshot-refresh.ts，crontab 00:05）驱动，页面访问惰性兜底。
model RankSnapshot {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @unique @db.BigInt
  ranks      Json
  delta      Int    @default(0) @db.Int
  baseDate   String @default("") @map("base_date") @db.Char(10)
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  // delta 索引服务进步榜 WHERE delta>0 ORDER BY delta DESC（2026-10-22 重构新增）
  // update_time 索引：幂等闸门「今日已刷新？」判定（2026-10-22 JSON 全表扫 1.9s 根治）
  @@index([delta])
  @@index([updateTime])
  @@map("rank_snapshot")
}

// 名次落盘表（2026-10-22 张老师定）：用户页/用户卡的全国名次+地区名次，替代 getUserRanks
// 的全表 ROW_NUMBER 窗口扫（慢日志实证 1.1s/次，站点常态 CPU 税大头）。
// 维护口径——触发点增量搬位（尽量不动全站）：
// · 审核通过/屏蔽录像 → sum_time 变化 → 出旧位进新位（review.ts）
// · 用户封禁/解禁（含限时封禁到期自动解禁）→ 出榜/回榜（ops.ts / ban.ts）
// 兜底：每日 00:05 rank-snapshot-refresh 顺带全量重建；读取侧在榜却缺行时自愈重建。
// 平序破法 (sum_time ASC, id ASC)——ROW_NUMBER 必须可复现，增量位移才成立。
model UserRank {
  id         BigInt @id @db.BigInt // = user.id
  national   Int // 全国名次（sum_time 升序）
  area       String @db.VarChar(12) // 军区（原样存 user.area；空/含& 时 area_pos 为 null）
  areaPos    Int?   @map("area_pos")
  updateTime BigInt @map("update_time") @db.BigInt

  // national 索引：增量位移 UPDATE ... WHERE national >= ? 走索引
  @@index([national])
  @@index([area, areaPos])
  @@map("user_rank")
}

