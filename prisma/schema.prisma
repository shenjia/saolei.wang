  clicks       Int     @default(0) @db.Int
  clicker      String? @db.Char(40)
  downloads    Int     @default(0) @db.Int
  downloader   String? @db.Char(40)
  comments     Int     @default(0) @db.Int
  // 管理员在后台播放器里看过（2026-10-19：防盲审口径=downloads>0 或 admin_watched；
  // 免核定批量通过不查此列——池内零触发器命中，由分拣闸门保证）
  adminWatched Int     @default(0) @map("admin_watched") @db.TinyInt
  createTime   BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime   BigInt  @default(0) @map("update_time") @db.BigInt

  // 2026-10-15 上线前性能审计新增：热评/热门录像列表按 comments/clicks 过滤排序，
  // 原为 30 万行全表或长程主键扫描
  @@index([comments])
  @@index([clicks])
  @@map("video_stat")
}

// 录像「本局表现」六维指标（2026-10-14 张老师需求：录像分析雷达图）
// 由离线重放引擎 src/lib/videoradar.ts 算得（mvf/avf 头部没有这些字段，只能重放事件流）。
// id 直接用 video.id（不自增），跑批幂等 upsert；详情页缺行时即时重放补写。
// 六维：速度 bvs / 效率 ioe / 精准 corr / 手速 cls / 移动 ppc（越小越好）/ 综合 stnb。
model VideoMetrics {
  id         BigInt  @id @db.BigInt
  level      String  @db.Char(3)
  noflag     Boolean
  realTime   Int     @map("real_time") @db.Int
  bbbv       Int     @db.Int
  cl         Int     @db.Int
  clLeft     Int     @map("cl_left") @db.Int
  clRight    Int     @map("cl_right") @db.Int
  clDouble   Int     @map("cl_double") @db.Int
  ce         Int     @db.Int
  unflag     Int     @db.Int
  path       Int     @db.Int
  bvs        Float   @db.Float
  ioe        Float   @db.Float
  corr       Float   @db.Float
  cls        Float   @db.Float
  ppc        Float   @db.Float
  // 吞吐效率 = 已完成 3BV ÷ 有效点击 Ce（2026-10-28 轴调整：「效率」轴 FL 组口径；NF 组仍用 ioe）
  // ⚠️ 必须带 @default：线上 30 万行，无默认值的必填列会让 CI 的非交互 db push 拒绝执行（2026-10-28 实证）
  thrp       Float   @default(0) @db.Float
  // 走位 = 已完成 3BV ÷ 鼠标行程（格）（2026-10-28 张老师定上雷达替换「精准」corr 轴）
  bpp        Float   @default(0) @db.Float
  // 跨格次数 = 鼠标轨迹跨过格线的次数（0.5px 步长光栅化，格内抖动不计）。
  // 2026-10-29 张老师定「路线规划」分母由 path 换 crossings（3BV/CP）：连续 PATH 按
  // 事件间欧氏累加，鼠标回报率越高 mv 采样越密、抖动噪声进得越多 → 同一轨迹 Path
  // 系统性偏长；crossings 只数跨格线动作，对回报率**构造性免疫**。探针实测 6/6 组
  // 与 STNB 的秩相关全面优于 PATH（scripts/cellpath-probe.ts）。
  cp         Int     @default(0) @db.Int
  stnb       Float   @db.Float
  // QG 质量分 = (用时秒)^1.7 ÷ 已解 3BV（STNB 的中间量，越小越好）。
  // 2026-10-20 张老师定落库：此前只在回放/结算面板实时现算。只依赖 real_time×bbbv，
  // 故历史行回填免重放（跑批 --qg-only 一条 SQL 从本表两列直接算）。
  qg         Float   @default(0) @db.Float
  // 综合分（0-100）= **STNB 在「级别×模式」组内的分位**（2026-10-14 晚张老师改口径；
  // 旧口径「速度/效率/精准/手速四轴百分位加权平均」已弃）。与雷达「综合」轴读数一致。
  // 它依赖分位基准，所以不是一算永逸：基准一变就要全量重算（跑批里几十秒）。
  composite  Float   @default(0) @db.Float
  // 排名类**相对值**：新录像进来会挤动别人的名次，不能像事实字段那样一算永逸，
  // 由跑批每次用窗口函数全量重刷（30 万行几秒，不必重放进文件）。
  // rankAll 已停用：张老师 2026-10-14 定「不同级别不能放一起比较」，全站榜无意义，
  // 列保留（避免动生产表），跑批恒写 0。现只维护 rankGroup（级别×模式组内名次）
  // 与 beatPct（组内超越百分比，直接取 composite，与雷达气泡读数一致）。
  rankAll    Int     @default(0) @map("rank_all") @db.Int
  rankGroup  Int     @default(0) @map("rank_group") @db.Int
  beatPct    Float   @default(0) @map("beat_pct") @db.Float
  createTime BigInt  @default(0) @map("create_time") @db.BigInt

  @@index([rankAll])
  @@index([level, noflag, rankGroup])
  @@index([level, noflag, composite])
  // 2026-10-20 张老师要求：录像列表 IOE/STNB 排序列建索引（order=ioe/stnb 时
  // 索引反扫免 30 万行 filesort；本地实测建前 0.135s）
  @@index([ioe])
  @@index([stnb])
  @@map("video_metrics")
}

// 分位基准：video_metrics 按「级别 × NF/FL × 3BV」分组后的 9 档分位边界
// （与 distribution 表同构：每列是 GRADES 对应的 9 个阈值，逗号分隔）。
// bucket 存该组盘的 3BV 原值；bucket=-1 是「该级别该模式全组」兜底行，
// 单 3BV 样本不足 30 时回退用它。ppc（移动）是反向指标，边界按升序存（越小越好）。
model VideoMetricDist {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  level      String  @db.Char(3)
  noflag     Boolean
  bucket     Int     @db.Int
  size       Int     @db.Int
  bvs        String  @db.VarChar(255)
  ioe        String  @db.VarChar(255)
  corr       String  @db.VarChar(255)
  cls        String  @db.VarChar(255)
  ppc        String  @db.VarChar(255)
  thrp       String  @default("") @db.VarChar(255)
  bpp        String  @default("") @db.VarChar(255)
  stnb       String  @db.VarChar(255)
  // 2026-10-30 五轴改版（张老师定）：全网池专用列——level='all' 行（NF/FL 各一）用，
  // 普通行恒空串。「稀有程度」三合一取最高档需要 time/3bvs/stnb 三份全池边界；
  // 「有效点击」= CES（每秒有效点击）、「移动速度」= crossings/s，均全网评级。
  time       String  @default("") @db.VarChar(255)
  ces        String  @default("") @db.VarChar(255)
  cps        String  @default("") @db.VarChar(255)
  createTime BigInt  @default(0) @map("create_time") @db.BigInt

  @@unique([level, noflag, bucket])
  @@map("video_metric_dist")
}

// STNB 榜落盘（2026-10-20 张老师拍板）：每用户每级历史最高 STNB + 最优盘快照。
// 背景：实时聚合（video_metrics⋈video⋈video_info 30 万行三表 GROUP BY，生产 4~6s）
// 挂 1h 缓存后，每小时缓存过期的首个访客吃 6s——落盘后榜查询 ~0.1s 且过审实时上榜。
// 行数 ~2.4 万（user×level 组），极小。
// 写入口径（与原实时聚合完全同源）：
//   · 参与条件：v.status=20（过审胜局）+ m.stnb>0 + board_3bv ≥ MIN_3BV_FOR_3BVS（初10/中4/高4）
//   · 组内排序：stnb DESC, id ASC（同分取 id 小者）
// 写入点（四处，缺一处即失同步，见 lib/userstnb.ts 注释）：
//   ① 审核通过/屏蔽（lib/review.ts reviewVideo，最常见路径）
//   ② 跑批重算指标后（scripts/video-metrics.ts，stnb 值全量变的场景）
//   ③ 数据修正（级别/board_3bv 修复脚本）
//   ④ 全量重建命令（幂等重建，对账用）
model UserStnbBest {
  // user id（非 FK 约束，与 video_scores_* 同惯例——同步管线灌表顺序不保证）
  user       BigInt  @db.BigInt
  level      String  @db.Char(3)
  // 该级历史最高 STNB（1 位小数，与 video_metrics.stnb 同精度）
  stnb       Float   @db.Float
  // 最优盘快照：点击跳 /video/<bestVideo> + hover 气泡「高级 xx.xx 秒 NF 3月前」
  bestVideo  BigInt  @map("best_video") @db.BigInt
  bestTime   Int     @map("best_time") @db.Int
  bestNf     Boolean @map("best_nf")
  bestCt     BigInt  @map("best_ct") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  @@id([user, level])
  @@index([level, stnb])
  @@map("user_stnb_best")
}

// NF STNB 榜落盘：与 user_stnb_best 同构，仅统计 noflag=1 的已过审录像。
model UserStnbBestNf {
  user       BigInt  @db.BigInt
  level      String  @db.Char(3)
  stnb       Float   @db.Float
  bestVideo  BigInt  @map("best_video") @db.BigInt
  bestTime   Int     @map("best_time") @db.Int
  bestNf     Boolean @map("best_nf")
  bestCt     BigInt  @map("best_ct") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  @@id([user, level])
  @@index([level, stnb])
  @@map("user_stnb_best_nf")
}

// 各级别 3BV 收集区间（2026-10-13）：站内已通过（status=20）录像的 board_3bv 实际上下限，
