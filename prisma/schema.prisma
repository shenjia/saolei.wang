// ---------- 其他 ----------

model Donate {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  amount     BigInt @default(0) @db.BigInt
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  @@map("donate")
}

model Distribution {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  size       BigInt @db.BigInt
  title      String @db.VarChar(255)
  sumTime    String @map("sum_time") @db.VarChar(255)
  sum3bvs    String @map("sum_3bvs") @db.VarChar(255)
  begTime    String @map("beg_time") @db.VarChar(255)
  beg3bvs    String @map("beg_3bvs") @db.VarChar(255)
  intTime    String @map("int_time") @db.VarChar(255)
  int3bvs    String @map("int_3bvs") @db.VarChar(255)
  expTime    String @map("exp_time") @db.VarChar(255)
  exp3bvs    String @map("exp_3bvs") @db.VarChar(255)
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@map("distribution")
}

model News {
  id          BigInt @id @default(autoincrement()) @db.BigInt
  type        Int    @db.SmallInt
  user        BigInt @db.BigInt
  userScore   Int    @map("user_score") @db.Int
  reference   BigInt @default(0) @db.BigInt
  detailsData String @map("details_data") @db.VarChar(200)
  createTime  BigInt @default(0) @map("create_time") @db.BigInt

  @@index([user])
  @@map("news")
}

model Comment {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  video      BigInt  @db.BigInt
  user       BigInt  @db.BigInt
  userScore  Int     @map("user_score") @db.Int
  content    String? @db.Text
  status     Int     @default(0) @db.SmallInt
  createTime BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  @@index([video, createTime])
  @@map("comment")
}

// ---------- 2008 ASP 版功能移植新增表（2026-09-23） ----------

// 人气：看地盘计数（user+ip+date 去重，移植 2008 版 Click 表）
model Click {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  ip         String @db.VarChar(40)
  date       String @db.Char(10)
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  @@unique([user, ip, date])
  @@index([user, date])
  @@map("click")
}

// 每日一星（移植 2008 版 Star 表，每日评选一次、月度不重复）
model Star {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  date       String @db.Char(10)
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  @@unique([date])
  @@map("star")
}

// 扫雷历程：按月记事（移植 2008 版 History 表，同年月唯一）
model History {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  month      String @map("year_month") @db.Char(7)
  content    String @db.VarChar(500)
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  @@unique([user, month])
  @@map("history")
}

// 站内信（移植 2008 版 Message 表）
model Message {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  fromUser   BigInt  @map("from_user") @db.BigInt
  toUser     BigInt  @map("to_user") @db.BigInt
  content    String  @db.VarChar(200)
  isRead     Boolean @default(false) @map("is_read")
  isSystem   Boolean @default(false) @map("is_system")
  createTime BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  @@index([toUser, isRead])
  @@map("message")
}

// 论坛主题（移植 2008 版 BBS Title 表；板块：0 公告 1 技术 2 杂谈 3 问答）
model BbsPost {
  id            BigInt  @id @default(autoincrement()) @db.BigInt
  board         Int     @default(1) @db.TinyInt
  user          BigInt  @db.BigInt
  title         String  @db.VarChar(100)
  content       String  @db.MediumText
  replies       Int     @default(0) @db.Int
  clicks        Int     @default(0) @db.Int
  isTop         Boolean @default(false) @map("is_top")
  isNice        Boolean @default(false) @map("is_nice")
  isLocked      Boolean @default(false) @map("is_locked")
  status        Int     @default(0) @db.SmallInt
  lastReplyTime BigInt  @default(0) @map("last_reply_time") @db.BigInt
  lastReplyUser BigInt  @default(0) @map("last_reply_user") @db.BigInt
  createTime    BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime    BigInt  @default(0) @map("update_time") @db.BigInt

  @@index([board, status, lastReplyTime])
  @@map("bbs_post")
}

// 论坛回复（移植 2008 版 BBS Reply 表）
model BbsReply {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  post       BigInt @db.BigInt
  user       BigInt @db.BigInt
  content    String @db.MediumText
  status     Int    @default(0) @db.SmallInt
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  @@index([post, status, id])
  @@map("bbs_reply")
}

// 排行每日快照（进步榜数据源，替代 2008 版「刷新排行」时的 Old_Rank）
model RankSnapshot {
  id          BigInt @id @default(autoincrement()) @db.BigInt
  user        BigInt @db.BigInt
  date        String @db.Char(10)
  sumTimeRank Int    @default(0) @map("sum_time_rank") @db.Int
  sum3bvsRank Int    @default(0) @map("sum_3bvs_rank") @db.Int
  createTime  BigInt @default(0) @map("create_time") @db.BigInt
  updateTime  BigInt @default(0) @map("update_time") @db.BigInt

  @@unique([user, date])
  @@map("rank_snapshot")
}

// ---------- 后台（2026-09-24 管理后台新增） ----------

// 后台操作日志：管理端一切写操作留痕（谁、何时、对谁、做了什么、来源 IP）
model AdminLog {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt // 操作人 user.id
  action     String @db.VarChar(40) // 动作标识，如 video.review / user.ban
  target     String @default("") @db.VarChar(20) // 目标类型：user / video / comment / bbs_post …
  targetId   BigInt @default(0) @map("target_id") @db.BigInt
  detail     String @default("") @db.VarChar(500) // 人类可读描述（列表直接展示）
  ip         String @default("") @db.VarChar(40)
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([user, createTime])
  @@index([action, createTime])
  @@index([createTime])
  @@map("admin_log")
}

// 密码重置令牌（邮箱找回，新版测试.txt 需求）
model PasswordToken {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  user       BigInt  @db.BigInt
  token      String  @db.Char(64)
  used       Boolean @default(false)
  createTime BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  @@unique([token])
  @@map("password_token")
}

// 头像审核（2026-09-24 张老师需求：个人资料页点击上传 + AI 初筛 + 人工复核）
// 旧站流程是「发邮件给站长人工开通照片」（见 /page/help/avatar），本表把它自动化。
// 状态：10 待审 / 20 已通过 / 0 已驳回。user.avatar 只在通过时才改写，
// 所以待审期间旧头像照常展示，驳回无需回滚。
model AvatarReview {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt // 上传者 user.id
  // 头像文件相对路径，如 /uploads/avatar/1-1758600000.jpg
  filepath   String @db.VarChar(120)
  status     Int    @default(10) @db.SmallInt // 10 待审 / 20 通过 / 0 驳回
  // AI 初审结果：verdict = pass/review，source = ai/disabled/timeout/error
  verdict    String @default("") @db.VarChar(16)
  source     String @default("") @db.VarChar(16)
  category   String @default("") @db.VarChar(16)
  reason     String @default("") @db.VarChar(200)
  // 通过前用户原本的 avatar 值（含空串 / OAuth 外链 / "1"），供管理员撤销自动放行时回滚
  prevAvatar String @default("") @map("prev_avatar") @db.Char(255)
  reviewer   BigInt @default(0) @db.BigInt // 人工审核人 user.id，0=仅 AI 自动放行
  reviewTime BigInt @default(0) @map("review_time") @db.BigInt
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([status, createTime])
  @@index([user, createTime])
  @@map("avatar_review")
}
