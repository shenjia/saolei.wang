  isTop         Boolean @default(false) @map("is_top")
  isPinned      Boolean @default(false) @map("is_pinned")
  isNice        Boolean @default(false) @map("is_nice")
  isLocked      Boolean @default(false) @map("is_locked")
  status        Int     @default(0) @db.SmallInt
  aiReason      String? @map("ai_reason") @db.VarChar(200)
  // ---- 称号快照制（2026-10-17，语义同 news.exp_time/ranked）----
  expTime       BigInt  @default(0) @map("exp_time") @db.BigInt
  ranked        BigInt  @default(0) @map("ranked") @db.BigInt
  lastReplyTime BigInt  @default(0) @map("last_reply_time") @db.BigInt
  lastReplyUser BigInt  @default(0) @map("last_reply_user") @db.BigInt
  createTime    BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime    BigInt  @default(0) @map("update_time") @db.BigInt

  // 2026-10-22 迁移收尾索引排查：列表排序 ORDER BY is_pinned DESC, (id|last_reply_time) DESC
  // 此前无任何索引可用，全板块路径全表 filesort 拖 content 大字段（实测 105ms）。
  // · (board, status, isPinned↓, lastReplyTime↓)：板内列表（含 nice 子集）免 filesort
  // · (status, isPinned↓, lastReplyTime↓)：全板块默认「最后回复」排序（/bbs 热路径）
  // · (status, isPinned↓, id↓)：全板块「发布时间」排序（getLatestPosts 首页右栏）
  @@index([board, status, isPinned(sort: Desc), lastReplyTime(sort: Desc)])
  @@index([status, isPinned(sort: Desc), lastReplyTime(sort: Desc)])
  @@index([status, isPinned(sort: Desc), id(sort: Desc)])
  @@map("bbs_post")
}

