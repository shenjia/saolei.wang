// 扫雷网（saolei.wang）数据库 schema
// 沿用 2013 年 PHP 新版（saolei.net）的 MySQL 设计，共 20 张表
// 字段命名与类型保持与原表一致，时间戳统一为 Unix 秒（bigint）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- 用户 ----------

model User {
  id            BigInt  @id @default(autoincrement()) @db.BigInt
  chineseName   String  @map("chinese_name") @db.VarChar(12)
  englishName   String  @map("english_name") @db.Char(32)
  sex           Int     @default(1) @db.TinyInt
  avatar        String  @default("") @db.Char(255)
  area          String  @default("") @db.VarChar(12)
  status        Int     @default(0) @db.SmallInt
  createTime    BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime    BigInt  @default(0) @map("update_time") @db.BigInt
  // 最近登录（2026-09-23 个人信息卡片新增，登录时刷新；0=未记录）
  lastLoginTime BigInt  @default(0) @map("last_login_time") @db.BigInt
  // 防小号关联（2026-10-19）：注册 IP 注册时落一次；最近登录 IP 每次 setSession 刷新（存量账号空串，随登录逐步积累）
  registerIp    String  @default("") @map("register_ip") @db.VarChar(45)
  lastLoginIp   String  @default("") @map("last_login_ip") @db.VarChar(45)
  // 封禁截止 Unix 秒（2026-10-16 限时封禁）：仅 status=-1 时有意义；0=永久封禁；到期自动解禁
  banUntil      BigInt  @default(0) @map("ban_until") @db.BigInt
  // 可信用户组（2026-10-24）：组内用户上传录像自动分拣时不检查 STNB 触发器（后台 /admin/users/[id] 超管维护）
  trusted       Boolean @default(false)
  // 赞助金额主页展示开关（2026-11-02 张老师定开关；2026-11-10 改为跟行内开关）：
  // false=公开（默认，个人主页数据统计展示赞助金额行）；
  // true=账户设置里关闭后个人主页隐藏该行。存 User 表（行恒存在，免 user_info upsert 判断）
  donateHidden  Boolean @default(false) @map("donate_hidden")
  // 年龄主页展示开关（2026-11-10 张老师：原「显示年龄与星座」开关分拆为年龄/星座两个独立开关，
  // 由年龄、星座行后的「在我的主页展示」开关控制；存量 birth_hidden 已回填后删除）：
  // false=公开（默认）；true=个人主页资料不显示年龄行。存 User 表（行恒存在）
  ageHidden           Boolean @default(false) @map("age_hidden")
  // 星座主页展示开关（同上，控制个人主页星座行）
  constellationHidden Boolean @default(false) @map("constellation_hidden")
  // 旧「显示年龄与星座」开关 birth_hidden 已于 2026-11-10 分拆为上两列并从生产库删除
  // （分拆次序：①schema 暂留旧列定义上线（纯加法）→②生产回填后 DROP→③摘除定义再上线）

  // ---- 反作弊处置（2026-10-27）：客户端探测命中（__op 蜜罐/棋盘注入/整页标记浮层）----
  // 排名模式禁用截止 Unix 秒：命中后 24 小时内无法开启排名模式（WS/上传/入口三处闸）
  rankBanUntil   BigInt @default(0) @map("rank_ban_until") @db.BigInt
  // 低信任标记截止 Unix 秒：并入 getUserTrustInfo 低信任口径（video.auto_reason bit9
  // 影响后台审核），且 24h 内上传录像数 ≤5；命中后 7 天
  lowTrustUntil  BigInt @default(0) @map("low_trust_until") @db.BigInt
  // 人工移出低信任组时刻 Unix 秒（2026-10-27）：后台「移出低信任用户组」写入。
  // 屏蔽史只在「最近一次屏蔽时刻 > 本值」时算入组依据——之后再有新录像被屏蔽会自动重新入组。
  // 口径见 src/lib/lowtrust.ts（列表 / 详情页 / 录像分拣三处共用，禁单边漂移）
  lowTrustExempt BigInt @default(0) @map("low_trust_exempt") @db.BigInt

  // 每日一星当选感言（2026-11-11 张老师定改预写制）：存用户表每人一份、一次性
  // （写后不可改），当选当日提取展示并同步镜像到当日 star 行；空串=未写或被管理员移除
  starSpeech    String @default("") @map("star_speech") @db.VarChar(84)
  // 感言被管理员删除次数（原 star 行口径移到用户维度）：≥2 = 永久不能再写（删两次封嘴）
  starSpeechDel Int    @default(0) @map("star_speech_del") @db.Int

  // 2026-10-15 上线前性能审计新增：
  // (area, status) 服务地区榜/地区内页取人口（原 (area,sex) 不覆盖）；
  // (status) 服务首页注册人数 count（ACTIVE_USER 口径）
  // 2026-10-21 后台性能：create_time 服务后台增长曲线/最新注册排序（原全表扫描 4.5s）
  @@index([area, status])
  @@index([status])
  @@index([area, sex])
  @@index([registerIp])
  @@index([lastLoginIp])
  @@index([createTime])
  @@map("user")
}

model UserInfo {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  qq         String  @default("") @db.VarChar(20)
  nickname   String  @default("") @db.VarChar(32)
  birthday   BigInt  @default(0) @db.BigInt
  mouse      String  @default("") @db.VarChar(60)
  pad        String  @default("") @db.VarChar(60)
  selfIntro  String? @map("self_intro") @db.VarChar(150)
  interest   String? @db.VarChar(150)
  // 称号体系偏好（2026-10-17 Phase 5 双体系）：'m'=军衔制（默认）/ 'c'=旧版称号（雷帝/雷圣/…/布衣）。
  // 渲染跟随**观看者**：未登录或未设置时固定渲染军衔制
  titlePref  String  @default("m") @map("title_pref") @db.Char(1)
  createTime BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  @@map("user_info")
}

model UserAuth {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  username   String @unique @db.Char(64)
  password   String @db.Char(32)
  salt       String @db.Char(32)
  role       Int    @default(0) @db.SmallInt
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  // 邮箱绑定（2026-10-15）：老用户登录名非邮箱，忘记密码无法自助找回。
  // email 未验证前只存草稿（email_verified=0）；找回密码只认已验证邮箱或本身是邮箱的登录名。
  email         String? @unique @db.VarChar(64)
  emailVerified BigInt  @default(0) @map("email_verified")
  emailToken    String? @unique @map("email_token") @db.Char(32)

  // 2026-11-09：绑定验证成功换名时保留原登录名（首次绑定时的 username，重绑不覆盖）。
  // 登录时 username 查不到按 old_username 识别并黄色提示引导用邮箱登录（不放行——
  // 旧站被爆过库，旧凭据不可信）——「很多人绑定邮箱后用旧名登录不上」的修复。
  oldUsername String? @map("old_username") @db.Char(64)

  @@index([oldUsername])
  @@map("user_auth")
}

// 用户最好成绩（flag 模式）
model UserScores {
  id           BigInt  @id @default(autoincrement()) @db.BigInt
  begTime      Int?    @map("beg_time") @db.Int
  beg3bvs      Int?    @map("beg_3bvs") @db.Int
  intTime      Int?    @map("int_time") @db.Int
  int3bvs      Int?    @map("int_3bvs") @db.Int
  expTime      Int?    @map("exp_time") @db.Int
  exp3bvs      Int?    @map("exp_3bvs") @db.Int
  sumTime      Int?    @map("sum_time") @db.Int
  sum3bvs      Int?    @map("sum_3bvs") @db.Int
  begTimeVideo BigInt? @map("beg_time_video") @db.BigInt
  beg3bvsVideo BigInt? @map("beg_3bvs_video") @db.BigInt
  intTimeVideo BigInt? @map("int_time_video") @db.BigInt
  int3bvsVideo BigInt? @map("int_3bvs_video") @db.BigInt
  expTimeVideo BigInt? @map("exp_time_video") @db.BigInt
  exp3bvsVideo BigInt? @map("exp_3bvs_video") @db.BigInt
  begTimeDate  BigInt? @map("beg_time_date") @db.BigInt
  beg3bvsDate  BigInt? @map("beg_3bvs_date") @db.BigInt
  intTimeDate  BigInt? @map("int_time_date") @db.BigInt
  int3bvsDate  BigInt? @map("int_3bvs_date") @db.BigInt
  expTimeDate  BigInt? @map("exp_time_date") @db.BigInt
  exp3bvsDate  BigInt? @map("exp_3bvs_date") @db.BigInt
  createTime   BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime   BigInt  @default(0) @map("update_time") @db.BigInt

  @@index([begTime])
  @@index([beg3bvs])
  @@index([intTime])
  @@index([int3bvs])
  @@index([expTime])
  @@index([exp3bvs])
  @@index([sumTime])
  @@index([sum3bvs])
  @@map("user_scores")
}

// 用户最好成绩（NF 无标模式）
model UserScoresNf {
  id           BigInt  @id @default(autoincrement()) @db.BigInt
  begTime      Int?    @map("beg_time") @db.Int
  beg3bvs      Int?    @map("beg_3bvs") @db.Int
  intTime      Int?    @map("int_time") @db.Int
  int3bvs      Int?    @map("int_3bvs") @db.Int
  expTime      Int?    @map("exp_time") @db.Int
  exp3bvs      Int?    @map("exp_3bvs") @db.Int
  sumTime      Int?    @map("sum_time") @db.Int
  sum3bvs      Int?    @map("sum_3bvs") @db.Int
  begTimeVideo BigInt? @map("beg_time_video") @db.BigInt
  beg3bvsVideo BigInt? @map("beg_3bvs_video") @db.BigInt
  intTimeVideo BigInt? @map("int_time_video") @db.BigInt
  int3bvsVideo BigInt? @map("int_3bvs_video") @db.BigInt
  expTimeVideo BigInt? @map("exp_time_video") @db.BigInt
  exp3bvsVideo BigInt? @map("exp_3bvs_video") @db.BigInt
  begTimeDate  BigInt? @map("beg_time_date") @db.BigInt
  beg3bvsDate  BigInt? @map("beg_3bvs_date") @db.BigInt
  intTimeDate  BigInt? @map("int_time_date") @db.BigInt
  int3bvsDate  BigInt? @map("int_3bvs_date") @db.BigInt
  expTimeDate  BigInt? @map("exp_time_date") @db.BigInt
  exp3bvsDate  BigInt? @map("exp_3bvs_date") @db.BigInt
  createTime   BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime   BigInt  @default(0) @map("update_time") @db.BigInt

  @@index([begTime])
  @@index([beg3bvs])
  @@index([intTime])
  @@index([int3bvs])
  @@index([expTime])
  @@index([exp3bvs])
  @@index([sumTime])
  @@index([sum3bvs])
  @@map("user_scores_nf")
}

model UserStat {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  loginTimes BigInt  @default(0) @map("login_times") @db.BigInt
  loginTime  BigInt  @default(0) @map("login_time") @db.BigInt
  loginIp    String? @map("login_ip") @db.Char(40)
  points     Int     @default(0) @db.Int
  clicks     Int     @default(0) @db.Int
  begVideos  Int     @default(0) @map("beg_videos") @db.Int
  intVideos  Int     @default(0) @map("int_videos") @db.Int
  expVideos  Int     @default(0) @map("exp_videos") @db.Int
  createTime BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  @@map("user_stat")
}

model UserSig {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  signature  String @unique @db.VarChar(50)
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  // 用户主页标识版块按 user 查（热路径）；signature 唯一索引管归属校验
  @@index([user])
  @@map("user_sig")
}

// 第三方登录绑定（微信扫码 / QQ扫码）
// 老用户账密登录后强制绑定其一；新用户扫码直接注册
model UserOauth {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  userId     BigInt @map("user_id") @db.BigInt
  provider   String @db.VarChar(10) // wechat | qq
  openid     String @db.VarChar(64)
  unionid    String @default("") @db.VarChar(64) // 微信 unionid，打通后续公众号/小程序
  nickname   String @default("") @db.VarChar(64) // 需 utf8mb4（微信昵称可能含 emoji）
  avatar     String @default("") @db.VarChar(255)
  createTime BigInt @default(0) @map("create_time") @db.BigInt
  updateTime BigInt @default(0) @map("update_time") @db.BigInt

  @@unique([provider, openid])
  @@index([userId])
  @@map("user_oauth")
}

// ---------- 录像 ----------

model Video {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  level      String  @db.Char(3)
  user       BigInt  @db.BigInt
  hash       String  @db.Char(32)
  status     Int     @default(0) @db.SmallInt
  reviewUser BigInt? @map("review_user") @db.BigInt
  reviewTime BigInt? @map("review_time") @db.BigInt
  createTime BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt
  // 连坐封禁前的 status（2026-10-16 限时封禁）：账号封禁勾选「同步封禁录像」时记录原值（10/20），
  // 解禁时据此精确恢复并清零；0=非连坐（单独屏蔽），解禁时不动
  statusBak  Int     @default(0) @map("status_bak") @db.TinyInt
  // ---- 称号快照制（2026-10-17，语义同 news.exp_time/ranked）：上传时刻作者高级成绩 + 是否在榜 ----
  expTime    BigInt  @default(0) @map("exp_time") @db.BigInt
  ranked     BigInt  @default(0) @map("ranked") @db.BigInt
  // ---- 自动分拣（2026-10-19 方案 v2：机器只分拣不审批，通过永远由管理员手动执行）----
  // 1=免核定（零触发器命中，可批量一键通过）；0=需核定（任一触发器命中，只能逐条手审）；
  // 2=分拣失败（解析/读文件失败，按需核定兜底）；-1=未分拣（历史存量未回填，视同 0 保守处理）
  autoFlag   Int     @default(-1) @map("auto_flag") @db.TinyInt
  // 位码触发原因（仅后台展示，玩家不可见）：
  // bit0 press-release≤60ms | bit1 STNB 分位 | bit2 cls>10 | bit3 path=0/ppc 异常
  // bit4 点击数不足 | bit5 首击<0.1s | bit6 破个人纪录 | bit7 级别 TOP 榜
  // bit8 首次入伍 | bit9 低信任（屏蔽/封禁史）
  // bit10 path 瞬移 | bit11 path 超速 | bit12/13 ms-toollib 不通过/可疑 | bit14 盲区率过低
  // bit15 排名 evf 签名不符 | bit16 排名局强制转手审标记（临时口径已停用，残留位重跑分拣即清）
  autoReason Int     @default(0) @map("auto_reason") @db.Int

  // ---- 本BV标记（2026-10-28 张老师需求，上传时刻判定落列，列表 3BV 角标用）----
  // first_bv=1：本玩家首次完成本 BV（同 user+level+board_3bv 此前无 status<>0 录像，口径与收集格同源）
  // pb_bv=1：打破本玩家本 BV 最好成绩（同池此前已有录像且本盘 real_time 严格更小；
  //   首盘只记 first_bv 不记 pb_bv——无「旧纪录」可破）
  firstBv Int @default(0) @map("first_bv") @db.TinyInt
  pbBv    Int @default(0) @map("pb_bv") @db.TinyInt

  // ---- 外站同步来源（2026-11-07 张老师定）：from_site=api_key.id；NULL=站内原生上传 ----
  // ①防递归：开源站按 video_list(id>cursor) 轮询抓雷网录像，外站同步落库的录像
  //   id 恒大于其游标水位，必须在轮询通道按调用方 key 过滤掉自家来源（video_list 路由内实现）；
  // ②from_id=对方站录像ID（2026-11-07 补：from_site 只答「哪个站」，ID 幂等键在此），
  //   (from_site, from_id) 唯一＝同步幂等键——worker 每轮重放按此等值查跳过已处理
  //   条目（开源站 query_by_id 列表不含 hash，无此键则每轮得重下载才算 md5，5/min 限速不可接受）
  fromSite BigInt? @map("from_site") @db.BigInt
  fromId   BigInt? @map("from_id") @db.BigInt

  // ---- 所属比赛（2026-11-13 张老师需求）：NULL=不挂比赛；本期由管理员在后台
  // 录像管理手动挂接（video.competition op），比赛详情页「录像」板块与排名按此聚合；
  // 成绩口径＝video_info.real_time（排行成绩口径 2026-10-30 张老师定）
  competitionId BigInt? @map("competition_id") @db.BigInt

  // 外站同步幂等键（2026-11-07）：同站同 remote id 唯一；NULL 行（站内原生）MySQL 不参与唯一约束
  @@unique([fromSite, fromId])
  // 2026-10-15 上线前性能审计新增：
  // (status, level, review_time) 一个索引覆盖 getVideoBoxStats/getSiteStats 的三项统计
  // （count status / GROUP BY level / 今日按 review_time），原为 30 万行全表扫描；
  // (level, id) 服务首页与录像列表的级别筛选 feed（原走主键反扫+过滤）
  // 2026-10-21 后台性能：create_time 服务后台趋势图 dailyCounts（30 天 GROUP BY 切天，
  // 原全表扫描 45s，加索引后 30ms）
  // 2026-10-22 默认排序改真上传时间序（张老师：id 序≠上传时间序，历史同步数据
  // 27.8 万处相邻逆序）：级别筛选 feed 按 (create_time, id) 倒序，(level, create_time)
  // 复合索引覆盖反扫（beg 首屏 0.34s→0.06s）
  @@index([status, level, reviewTime])
  @@index([level, id])
  @@index([level, createTime])
  @@index([user, level])
  @@index([hash])
  @@index([createTime])
  // (competition_id, create_time) 2026-11-13：比赛详情页「录像」板块按比赛取行
  // （正序时间序扫描）+ 后台按比赛筛选
  @@index([competitionId, createTime])
  // (review_user, status) 2026-10-22 迁移收尾索引排查：团队页 getTeam 逐管理员 count
  // （WHERE review_user=N AND status=20）原走 (status,…) 索引扫 15 万条目，实测 1.4s/人
  @@index([reviewUser, status])
  @@map("video")
}

model VideoInfo {
  id         BigInt  @id @default(autoincrement()) @db.BigInt
  filepath   String  @db.VarChar(100)
  signature  String  @db.VarChar(50)
  software   String  @db.VarChar(20)
  version    String  @db.VarChar(20)
  noflag     Boolean
  board      String  @db.VarChar(500)
  board3bv   Int     @map("board_3bv") @db.Int
  realTime   Int     @map("real_time") @db.Int
  // 2026-10-27 排名录像服务端签名（张老师要求）：排名局 evf 的 HMAC-SHA256（hex 64 位），
  // 密钥只在服务端（lib/evf-sign.ts 派生自 AUTH_SECRET）——文件被篡改即可验出。普通上传为 null
  evfSig     String? @map("evf_sig") @db.VarChar(64)
  // no_record=1：运气盘/不记成绩（2026-11-02 张老师定）。上传时 board_3bv 低于该级别
  // 下限（LEVEL_MIN_3BV：初 2/中 30/高 100）不再拒收，改打本标记——所有成绩（时间/
  // 3BV/s/STNB）划掉展示，不入 video_scores_*/user_scores/排行/纪录链/本BV标记；
  // 录像本体照常展示。只在上传时刻判定落列——历史录像恒 0 不受追溯
  // （如 76668 高级 95BV 老盘成绩照旧有效）
  noRecord   Boolean @default(false) @map("no_record")
  createTime BigInt  @default(0) @map("create_time") @db.BigInt
  updateTime BigInt  @default(0) @map("update_time") @db.BigInt

  // 2026-10-15 录像页表头排序/时间成绩搜索（张老师需求）：
  // real_time 支撑按成绩排序（索引序扫描免 30 万行 filesort）与时间搜索窗口过滤；
  // (board_3bv, real_time) 复合覆盖索引支撑按 3BV 排序（索引序扫描）与按 3BV/s 的
  // 计算排序（比值在索引内算得，filesort 免回表，306k 行 0.48s→0.17s 实测）
  @@index([realTime])
  @@index([board3bv, realTime])
  // NF 筛选（2026-10-20 张老师需求）：录像列表/首页 feed 的 NF 开关按
  // noflag=1 过滤（vi.noflag 在 video_info，30 万行无索引时全表扫 ~0.3s 冷启）；
  // 单列索引让 NF 查询走索引扫描（实测 count 0.28s→0.06s、列表页 0.33s→0.08s）
  @@index([noflag])
  // (noflag, create_time) 2026-10-22 默认排序改真上传时间序：NF 路径按
  // (create_time, id) 倒序，复合索引覆盖反扫免 filesort（p1 0.46s→0.09s）
  @@index([noflag, createTime])
  @@map("video_info")
}

model VideoStat {
