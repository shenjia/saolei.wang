  user       BigInt @db.BigInt
  scoreTime  Int    @map("score_time") @db.Int
  score3bvs  Int    @map("score_3bvs") @db.Int
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([scoreTime])
  @@index([score3bvs])
  @@index([user])
  @@map("video_scores_beg")
}

model VideoScoresBegNf {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  scoreTime  Int    @map("score_time") @db.Int
  score3bvs  Int    @map("score_3bvs") @db.Int
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([scoreTime])
  @@index([score3bvs])
  @@index([user])
  @@map("video_scores_beg_nf")
}

model VideoScoresInt {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  scoreTime  Int    @map("score_time") @db.Int
  score3bvs  Int    @map("score_3bvs") @db.Int
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([scoreTime])
  @@index([score3bvs])
  @@index([user])
  @@map("video_scores_int")
}

model VideoScoresIntNf {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  scoreTime  Int    @map("score_time") @db.Int
  score3bvs  Int    @map("score_3bvs") @db.Int
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([scoreTime])
  @@index([score3bvs])
  @@index([user])
  @@map("video_scores_int_nf")
}

model VideoScoresExp {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  scoreTime  Int    @map("score_time") @db.Int
  score3bvs  Int    @map("score_3bvs") @db.Int
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([scoreTime])
  @@index([score3bvs])
  @@index([user])
  @@map("video_scores_exp")
}

model VideoScoresExpNf {
  id         BigInt @id @default(autoincrement()) @db.BigInt
  user       BigInt @db.BigInt
  scoreTime  Int    @map("score_time") @db.Int
  score3bvs  Int    @map("score_3bvs") @db.Int
  createTime BigInt @default(0) @map("create_time") @db.BigInt

  @@index([scoreTime])
  @@index([score3bvs])
