# 复制为 .env 后按需填写（.env 不入仓，凭据一律走本地）

# MySQL 连接（本地开发推荐导入最小种子库，见 README「快速开始」）
DATABASE_URL=mysql://root@localhost:3306/saolei

# 会话签名密钥（JWT HMAC），任意随机长串
AUTH_SECRET=

# 录像文件主站兜底（开发环境本地无 55 万录像文件时，缺失的录像按此反代主站播放/下载；
# 留空则缺失录像直接 404）
VIDEO_FALLBACK_ORIGIN=https://saolei.wang

# 站点对外地址（邮箱找回密码链接等用）
SITE_URL=http://localhost:3000

# —— 以下均为可选能力，不配置只影响对应功能 ——

# 头像 AI 审核（智谱视觉 glm-4v-flash）与 UGC 后置 AI 文本审核（glm-4-flash）
GLM_API_KEY=
GLM_VISION_MODEL=glm-4v-flash
GLM_TEXT_MODEL=glm-4-flash
# 置 false 可关闭文本 AI 审核（默认开）
# TEXT_AI_ENABLED=true

# QQ 互联扫码登录（网站应用审核通过后填写）
QQ_APP_ID=
QQ_APP_KEY=

# SMTP（邮箱绑定 / 找回密码；未配置时重置链接打日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
